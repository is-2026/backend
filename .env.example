# Copiar como .env (cp .env.example .env) y ajustar los valores.

# --- Contenedor MySQL ---
MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=futbot
MYSQL_USER=futbot
MYSQL_PASSWORD=futbot

# --- Conexión del backend ---
# Puerto publicado en tu máquina. Cambiar si ya tenés un MySQL local en el 3306.
MYSQL_PORT=3306